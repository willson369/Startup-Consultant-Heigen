# OpenAI-compatible provider (可接 OpenAI / 通义千问兼容接口 / DeepSeek 兼容接口)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 本地免费模型（推荐中文：qwen2.5:7b-instruct）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# 模型调用顺序：默认先本地免费，再兼容API，再Anthropic
MODEL_PROVIDER_ORDER=ollama,openai,anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
X_BEARER_TOKEN=
INTEL_MAX_ITEMS=8
PORT=4173
