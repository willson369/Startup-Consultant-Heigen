# 通义千问（阿里云百炼 DashScope，OpenAI 兼容模式）
# 控制台创建 API-KEY：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
ENABLE_WEB_SEARCH=true

# 兼容旧变量名：若未设 DASHSCOPE_API_KEY，则使用 OPENAI_API_KEY
OPENAI_API_KEY=

# 只走通义；不要把占位符写进密钥字段
MODEL_PROVIDER_ORDER=openai

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
X_BEARER_TOKEN=
INTEL_MAX_ITEMS=8
PORT=4173
